{
    "name": "ugarit/wayfinder",
    "description": "Generate TypeScript representations of your Ugarit actions and routes.",
    "keywords": [
        "php",
        "ugarit",
        "typescript",
        "routes"
    ],
    "homepage": "https://github.com/ugarit/wayfinder",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/wayfinder/issues",
        "source": "https://github.com/ugarit/wayfinder"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "heritage/console": "^1.00.00",
        "heritage/filesystem": "^1.00.00",
        "heritage/routing": "^1.00.00",
        "heritage/support": "^1.00.00",
        "phpstan/phpdoc-parser": "^2.3"
    },
    "require-dev": {
        "ugarit/pint": "^1.00.00",
        "orchestra/testbench": "^11.0|^10.1|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Wayfinder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "workbench/app/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "format": [
            "@php vendor/bin/pint --dirty"
        ]
    },
    "extra": {
        "ugarit": {
            "providers": [
                "Ugarit\\Wayfinder\\WayfinderServiceProvider"
            ]
        }
    }
}
